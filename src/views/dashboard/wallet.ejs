<%- include('../partials/head', { title }) %>
<%- include('../partials/nav') %>
<%- include('../partials/dashboard_shell_open', { active }) %>

  <h1 class="text-2xl font-extrabold mb-1">Wallet</h1>
  <p class="text-gray-500 mb-6">Balance: <strong><%= site.currency %><%= currentUser.wallet_balance.toFixed(2) %></strong></p>

  <%- include('../partials/flash') %>

  <div class="grid lg:grid-cols-2 gap-6">
    <div class="bg-white border border-gray-100 rounded-xl p-6">
      <h2 class="font-bold mb-4">Add funds</h2>
      <form action="/dashboard/wallet/fund-request" method="POST" class="space-y-4">
        <div>
          <label class="block text-sm font-medium mb-1">Amount (min <%= site.currency %><%= minDeposit %>)</label>
          <input type="number" step="0.01" min="<%= minDeposit %>" name="amount" required
            class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Payment method</label>
          <select name="method" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
            <option value="bank_transfer">Bank transfer</option>
            <option value="upi">UPI</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Payment reference / UTR (optional)</label>
          <input name="reference" placeholder="So we can match your payment faster"
            class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
        </div>
        <button class="w-full py-2.5 rounded-lg brand-gradient text-white font-semibold hover:opacity-90">Submit top-up request</button>
        <div class="text-center my-3">
  <p class="mb-2 text-sm font-medium">Scan the QR code below to pay</p>
  <img src="/img/qr.png" alt="UPI QR Code" style="max-width: 180px; height: auto;" class="mb-2 img-thumbnail mx-auto" />
  <p class="mb-1 text-sm"><strong>UPI ID:</strong> <code>akashkushwaha14385@okhdfcbank</code></p>
  <small class="text-muted">Payment karne ke baad UTR / Transaction ID daal kar Submit karein.</small>
</div>
    <div class="bg-white border border-gray-100 rounded-xl">
      <div class="px-5 py-3 border-b border-gray-100 font-semibold text-sm">Your top-up requests</div>
      <% if (fundRequests.length === 0) { %>
        <p class="p-5 text-sm text-gray-500">No top-up requests yet.</p>
      <% } else { %>
        <table class="w-full text-sm">
          <tbody class="divide-y divide-gray-100">
            <% fundRequests.forEach(function(f) { %>
              <tr>
                <td class="px-5 py-3"><%= site.currency %><%= f.amount.toFixed(2) %></td>
                <td class="px-5 py-3 text-gray-500 capitalize"><%= f.method.replace('_',' ') %></td>
                <td class="px-5 py-3">
                  <span class="px-2 py-0.5 rounded-full text-xs font-semibold
                    <%= f.status === 'approved' ? 'bg-green-100 text-green-700' :
                        f.status === 'rejected' ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-700' %>">
                    <%= f.status %>
                  </span>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

  <div class="bg-white border border-gray-100 rounded-xl mt-6">
    <div class="px-5 py-3 border-b border-gray-100 font-semibold text-sm">Transaction history</div>
    <% if (transactions.length === 0) { %>
      <p class="p-5 text-sm text-gray-500">No transactions yet.</p>
    <% } else { %>
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-gray-500 text-left">
          <tr><th class="px-5 py-2 font-semibold">Date</th><th class="px-5 py-2 font-semibold">Type</th><th class="px-5 py-2 font-semibold">Note</th><th class="px-5 py-2 font-semibold">Amount</th><th class="px-5 py-2 font-semibold">Balance after</th></tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% transactions.forEach(function(t) { %>
            <tr>
              <td class="px-5 py-3 text-gray-500 whitespace-nowrap"><%= t.created_at %></td>
              <td class="px-5 py-3 capitalize"><%= t.type %></td>
              <td class="px-5 py-3 text-gray-500"><%= t.note %></td>
              <td class="px-5 py-3 font-semibold <%= t.amount >= 0 ? 'text-green-600' : 'text-gray-700' %>">
                <%= t.amount >= 0 ? '+' : '' %><%= site.currency %><%= t.amount.toFixed(2) %>
              </td>
              <td class="px-5 py-3"><%= site.currency %><%= t.balance_after.toFixed(2) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>

<%- include('../partials/dashboard_shell_close') %>
<%- include('../partials/footer') %>
