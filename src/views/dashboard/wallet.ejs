<%- include('../partials/head', { title }) %>
<%- include('../partials/nav') %>
<%- include('../partials/dashboard_shell_open', { active }) %>

  <h1 class="text-2xl font-extrabold mb-1">Wallet</h1>
  <p class="text-gray-500 mb-6">Balance: <strong><%= site.currency %><%= currentUser.wallet_balance.toFixed(2) %></strong></p>

  <%- include('../partials/flash') %>
  <div class="grid lg:grid-cols-2 gap-6">
  <div class="bg-white border border-gray-100 rounded-xl p-6">
    <h2 class="text-lg font-bold text-gray-900 mb-4">Add funds</h2>

    <form action="/dashboard/wallet/fund-request" method="POST" id="fund-form" class="space-y-4">
      <div>
        <label class="block text-sm font-medium mb-1">Method</label>
        <select id="pay-method" name="method" onchange="updateMethodUI()" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm bg-white">
          <option value="qr_auto" selected>Pay via Any UPI App</option>
          <option value="upi">UPI ID + UTR Manual</option>
          <option value="bank_transfer">Bank Transfer / Other</option>
        </select>
      </div>

      <div id="method-instructions" class="rounded-lg border border-gray-200 bg-gray-50 p-3.5 text-sm space-y-2.5">
        <div class="font-semibold text-gray-800">Instructions</div>
        <p class="font-semibold text-gray-800">[ 1 ] Enter Amount &amp; Click on Pay</p>
        <p class="font-semibold text-gray-800 leading-snug">
          [ 2 ] Scan / Download QR &amp; Pay Using Any UPI App
          <span class="text-blue-600">And Wait Few Second</span> For Fund to be Credited.
        </p>
        <div class="text-xs font-semibold text-blue-600 space-y-0.5 pt-1">
          <div>Minimum Amount :- <%= site.currency %><%= minDeposit %></div>
          <div>Maximum Amount :- <%= site.currency %>100000</div>
        </div>
        <div class="pt-1">
          <div class="font-semibold text-gray-800">Payment Failed?</div>
          <p class="text-xs text-gray-500">If your payment fails or the QR code doesn't work, please contact our support team for assistance</p>
        </div>
      </div>

      <div id="ref-box" class="hidden">
        <label class="block text-sm font-medium mb-1">UTR / Transaction ID</label>
        <input id="pay-ref" type="text" name="reference" placeholder="Enter UTR / Reference number" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
      </div>

      <div>
        <label class="block text-sm font-medium mb-1">Amount</label>
        <input id="pay-amount" type="number" step="0.01" min="<%= minDeposit %>" max="100000" name="amount" placeholder="Amount" required class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
      </div>

      <button type="button" onclick="openQrModal()" class="w-full py-2.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-semibold">
        Pay
      </button>

      <!-- QR Payment Modal -->
      <div id="qr-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-800/75 p-4">
        <div class="w-full max-w-sm rounded-xl bg-white p-6 text-center shadow-xl space-y-4">
          <div>
            <h3 class="text-lg font-bold text-gray-900"><%= site.name || 'Wallet Top-Up' %></h3>
            <p class="text-xs text-gray-500 mt-0.5">Transfer to</p>
          </div>

          <div class="flex items-center justify-between border-y border-gray-200 py-2.5 text-sm">
            <span class="font-semibold text-gray-700">Total Amount</span>
            <span id="modal-amount" class="font-bold text-blue-600 text-base">100</span>
          </div>

          <div class="flex justify-center py-1">
            <img id="qr-modal-img" src="/img/qr.png" alt="Payment QR Code" class="w-56 h-56 object-contain border rounded-lg p-2">
          </div>

          <p class="text-xs font-medium text-gray-700">
            This QR code will expire in <span id="qr-timer" class="font-bold text-gray-900">09:58</span>
          </p>

          <div class="flex items-center justify-center gap-2 pt-1">
            <button type="button" onclick="closeQrModal()" class="px-4 py-2 rounded-md bg-rose-500 hover:bg-rose-600 text-white text-xs font-semibold">
              Cancel
            </button>
            
          </div>
        </div><button type="submit" onclick="document.getElementById('fund-form').submit()" class="px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold">
  I Have Paid
</button>
      </div>
    </form>
  </div>

  <div>
    <div class="bg-white border border-gray-100 rounded-xl">
      <div class="px-5 py-3 border-b border-gray-100 font-semibold text-sm">Your top-up requests</div>
      <% if (fundRequests.length === 0) { %>
        <p class="p-5 text-sm text-gray-500">No top-up requests yet.</p>
      <% } else { %>
        <table class="w-full text-sm">
          <tbody class="divide-y divide-gray-100">
            <% fundRequests.forEach(function(f) { %>
              <tr>
                <td class="px-5 py-3"><%= site.currency %><%= f.amount.toFixed(2) %></td>
                <td class="px-5 py-3 text-gray-500 capitalize"><%= f.method.replace('_',' ') %></td>
                <td class="px-5 py-3">
                  <span class="px-2 py-0.5 rounded-full text-xs font-semibold <%= f.status === 'approved' ? 'bg-green-100 text-green-700' : f.status === 'rejected' ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-800' %>">
                    <%= f.status %>
                  </span>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>

    <div class="bg-white border border-gray-100 rounded-xl mt-6">
      <div class="px-5 py-3 border-b border-gray-100 font-semibold text-sm">Transaction history</div>
      <% if (transactions.length === 0) { %>
        <p class="p-5 text-sm text-gray-500">No transactions yet.</p>
      <% } else { %>
        <table class="w-full text-sm">
          <thead class="bg-gray-50 text-gray-500 text-left">
            <tr>
              <th class="px-5 py-2 font-semibold">Date</th>
              <th class="px-5 py-2 font-semibold">Type</th>
              <th class="px-5 py-2 font-semibold">Note</th>
              <th class="px-5 py-2 font-semibold">Amount</th>
              <th class="px-5 py-2 font-semibold">Balance</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% transactions.forEach(function(t) { %>
              <tr>
                <td class="px-5 py-3 text-gray-500 whitespace-nowrap"><%= t.created_at %></td>
                <td class="px-5 py-3 capitalize"><%= t.type %></td>
                <td class="px-5 py-3 text-gray-500"><%= t.note %></td>
                <td class="px-5 py-3 font-semibold <%= t.amount >= 0 ? 'text-green-600' : 'text-red-600' %>">
                  <%= t.amount >= 0 ? '+' : '' %><%= site.currency %><%= t.amount.toFixed(2) %>
                </td>
                <td class="px-5 py-3"><%= site.currency %><%= t.balance_after.toFixed(2) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</div>

<script>
let qrInterval = null;

function updateMethodUI() {
  const method = document.getElementById('pay-method').value;
  const inst = document.getElementById('method-instructions');
  const refBox = document.getElementById('ref-box');

  if (method === 'qr_auto') {
    refBox.classList.add('hidden');
    inst.innerHTML = `
      <div class="font-semibold text-gray-800">Instructions</div>
      <p class="font-semibold text-gray-800">[ 1 ] Enter Amount &amp; Click on Pay</p>
      <p class="font-semibold text-gray-800 leading-snug">[ 2 ] Scan / Download QR &amp; Pay Using Any UPI App <span class="text-blue-600">And Wait Few Second</span> For Fund to be Credited.</p>
      <div class="text-xs font-semibold text-blue-600 space-y-0.5 pt-1">
        <div>Minimum Amount :- <%= site.currency %><%= minDeposit %></div>
        <div>Maximum Amount :- <%= site.currency %>100000</div>
      </div>
      <div class="pt-1">
        <div class="font-semibold text-gray-800">Payment Failed?</div>
        <p class="text-xs text-gray-500">If your payment fails or the QR code doesn't work, please contact our support team for assistance</p>
      </div>
    `;
  } else if (method === 'upi') {
    refBox.classList.remove('hidden');
    inst.innerHTML = `
      <div class="font-semibold text-gray-800">UPI Details</div>
      <p class="text-sm text-gray-700">Pay to UPI ID: <strong>akashkushwaha14385@okhdfcbank</strong></p>
      <p class="text-xs text-gray-500">Payment ke baad 12-digit UTR / Reference ID upar box mein daalein.</p>
    `;
  } else {
    refBox.classList.remove('hidden');
    inst.innerHTML = `
      <div class="font-semibold text-gray-800">Bank Transfer / Other</div>
      <p class="text-xs text-gray-600">Transfer ke baad reference / UTR daal kar submit karein; team verify karegi.</p>
    `;
  }
}

function startQrTimer(seconds = 598) {
  clearInterval(qrInterval);
  let remaining = seconds;
  const el = document.getElementById('qr-timer');
  function tick() {
    const mins = String(Math.floor(remaining / 60)).padStart(2, '0');
    const secs = String(remaining % 60).padStart(2, '0');
    el.textContent = `${mins}:${secs}`;
    if (remaining <= 0) {
      clearInterval(qrInterval);
      closeQrModal();
      return;
    }
    remaining -= 1;
  }
  tick();
  qrInterval = setInterval(tick, 1000);
}

function openQrModal() {
  const amountInput = document.getElementById('pay-amount');
  const amt = parseFloat(amountInput.value);
  const minAmt = parseFloat('<%= minDeposit %>') || 10;

  if (!amt || amt < minAmt) {
    amountInput.focus();
    amountInput.reportValidity();
    return;
  }

  const method = document.getElementById('pay-method').value;
  if (method !== 'qr_auto') {
    document.getElementById('fund-form').submit();
    return;
  }

  document.getElementById('modal-amount').textContent = amt;
  const upiUri = encodeURIComponent(`upi://pay?pa=akashkushwaha14385@okhdfcbank&pn=WalletTopup&am=${amt}&cu=INR`); 
  const imgEl = document.getElementById('qr-modal-img');
  imgEl.onerror = function () {
    this.onerror = null;
    this.src = '/img/qr.png';
  };
  imgEl.src = `https://api.qrserver.com/v1/create-qr-code/?size=240x240&data=${upiUri}`;

  const modal = document.getElementById('qr-modal');
  modal.classList.remove('hidden');
  modal.classList.add('flex');
  startQrTimer(598);
}

function closeQrModal() {
  clearInterval(qrInterval);
  const modal = document.getElementById('qr-modal');
  modal.classList.add('hidden');
  modal.classList.remove('flex');
}
</script>

<%- include('../partials/dashboard_shell_close') %>
<%- include('../partials/footer') %> 