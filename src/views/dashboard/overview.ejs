<%- include('../partials/head', { title }) %>
<%- include('../partials/nav') %>
<%- include('../partials/dashboard_shell_open', { active }) %>

  <h1 class="text-2xl font-extrabold mb-1">Hi <%= currentUser.name.split(' ')[0] %> 👋</h1>
  <p class="text-gray-500 mb-6">Here's what's happening with your account.</p>

  <%- include('../partials/flash') %>

  <div class="grid sm:grid-cols-3 gap-4 mb-8">
    <div class="bg-white border border-gray-100 rounded-xl p-5">
      <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Wallet balance</p>
      <p class="text-2xl font-extrabold"><%= site.currency %><%= currentUser.wallet_balance.toFixed(2) %></p>
      <a href="/dashboard/wallet" class="text-xs text-brand-700 font-semibold hover:underline mt-2 inline-block">Add funds &rarr;</a>
    </div>
    <div class="bg-white border border-gray-100 rounded-xl p-5">
      <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Recent orders</p>
      <p class="text-2xl font-extrabold"><%= orders.length %></p>
      <a href="/dashboard/orders" class="text-xs text-brand-700 font-semibold hover:underline mt-2 inline-block">View all &rarr;</a>
    </div>
    <div class="bg-white border border-gray-100 rounded-xl p-5">
      <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Place a new order</p>
      <a href="/dashboard/order/new" class="inline-block mt-2 px-4 py-2 rounded-lg brand-gradient text-white text-sm font-semibold">New order</a>
    </div>
  </div>

  <div class="grid lg:grid-cols-2 gap-6">
    <div class="bg-white border border-gray-100 rounded-xl">
      <div class="px-5 py-3 border-b border-gray-100 font-semibold text-sm">Recent orders</div>
      <% if (orders.length === 0) { %>
        <p class="p-5 text-sm text-gray-500">No orders yet. <a href="/dashboard/order/new" class="text-brand-700 underline">Place your first one</a>.</p>
      <% } else { %>
        <table class="w-full text-sm">
          <tbody class="divide-y divide-gray-100">
            <% orders.forEach(function(o) { %>
              <tr>
                <td class="px-5 py-3"><%= o.service_name %></td>
                <td class="px-5 py-3 text-gray-500">x<%= o.quantity %></td>
                <td class="px-5 py-3">
                  <span class="px-2 py-0.5 rounded-full text-xs font-semibold
                    <%= o.status === 'completed' ? 'bg-green-100 text-green-700' :
                        (o.status === 'failed' || o.status === 'canceled') ? 'bg-red-100 text-red-700' :
                        'bg-amber-100 text-amber-700' %>">
                    <%= o.status %>
                  </span>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>

    <div class="bg-white border border-gray-100 rounded-xl">
      <div class="px-5 py-3 border-b border-gray-100 font-semibold text-sm">Recent wallet activity</div>
      <% if (transactions.length === 0) { %>
        <p class="p-5 text-sm text-gray-500">No wallet activity yet.</p>
      <% } else { %>
        <table class="w-full text-sm">
          <tbody class="divide-y divide-gray-100">
            <% transactions.forEach(function(t) { %>
              <tr>
                <td class="px-5 py-3 capitalize"><%= t.type %></td>
                <td class="px-5 py-3 font-semibold <%= t.amount >= 0 ? 'text-green-600' : 'text-gray-700' %>">
                  <%= t.amount >= 0 ? '+' : '' %><%= site.currency %><%= t.amount.toFixed(2) %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

<%- include('../partials/dashboard_shell_close') %>
<%- include('../partials/footer') %>
