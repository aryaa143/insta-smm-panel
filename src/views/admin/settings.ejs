<%- include('../partials/head', { title }) %>
<%- include('../partials/nav') %>
<%- include('../partials/admin_shell_open', { active }) %>

  <h1 class="text-2xl font-extrabold mb-6">Settings</h1>

  <%- include('../partials/flash') %>

  <form action="/admin/settings" method="POST" class="bg-white border border-gray-100 rounded-xl p-6 max-w-xl space-y-5">
    <div>
      <h2 class="font-bold text-sm text-gray-500 uppercase tracking-wide mb-3">Branding</h2>
      <div class="space-y-3">
        <div>
          <label class="block text-sm font-medium mb-1">Site name</label>
          <input name="app_name" value="<%= settings.app_name %>" required class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium mb-1">Currency symbol</label>
            <input name="currency_symbol" value="<%= settings.currency_symbol %>" required class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Support email</label>
            <input name="support_email" value="<%= settings.support_email %>" required class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
          </div>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-100 pt-5">
      <h2 class="font-bold text-sm text-gray-500 uppercase tracking-wide mb-3">Orders &amp; wallet</h2>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-sm font-medium mb-1">Default markup on sync</label>
          <input name="default_markup" type="number" step="0.01" min="1" value="<%= settings.default_markup %>" required class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
          <p class="text-xs text-gray-400 mt-1">1.4 = +40% over provider cost for newly synced services.</p>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Minimum top-up amount</label>
          <input name="min_deposit" type="number" step="1" min="1" value="<%= settings.min_deposit %>" required class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
        </div>
      </div>
    </div>

    <div class="border-t border-gray-100 pt-5">
      <h2 class="font-bold text-sm text-gray-500 uppercase tracking-wide mb-3">Upstream provider API</h2>
      <p class="text-xs text-gray-500 mb-3">
        This is the real company that actually delivers followers/likes/views on your orders.
        Paste your provider account's API endpoint and key below (most providers follow the
        standard "SMM Panel API" format: action=services/add/status/balance).
      </p>
      <div class="space-y-3">
        <div>
          <label class="block text-sm font-medium mb-1">Provider API URL</label>
          <input name="provider_api_url" value="<%= settings.provider_api_url %>" placeholder="https://provider-domain.example/api/v2"
            class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Provider API key</label>
          <input name="provider_api_key" value="<%= settings.provider_api_key %>" placeholder="your-provider-api-key"
            class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono" />
        </div>
      </div>
    </div>

    <button class="w-full py-2.5 rounded-lg brand-gradient text-white font-semibold hover:opacity-90">Save settings</button>
  </form>

<%- include('../partials/admin_shell_close') %>
<%- include('../partials/footer') %>
