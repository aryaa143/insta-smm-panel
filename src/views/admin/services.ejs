<%- include('../partials/head', { title }) %>
<%- include('../partials/nav') %>
<%- include('../partials/admin_shell_open', { active }) %>

  <div class="flex items-center justify-between mb-1">
    <h1 class="text-2xl font-extrabold">Services</h1>
    <form action="/admin/services/sync" method="POST">
      <button class="px-4 py-2 rounded-lg brand-gradient text-white text-sm font-semibold hover:opacity-90">
        Sync from provider
      </button>
    </form>
  </div>
  <p class="text-gray-500 mb-6">
    <%= services.length %> service(s) in your catalog.
    <% if (!providerConfigured) { %>
      <span class="text-amber-600">Provider API isn't configured yet &mdash; set it on the <a href="/admin/settings" class="underline">Settings</a> page before syncing.</span>
    <% } %>
  </p>

  <%- include('../partials/flash') %>

  <% if (services.length === 0) { %>
    <div class="bg-white border border-dashed border-gray-200 rounded-xl p-8 text-center text-gray-500">
      No services yet. Click "Sync from provider" to pull in your upstream provider's catalog
      (new services are added disabled, with pricing pre-filled at your default markup, so you can
      review before they go live on the storefront).
    </div>
  <% } else { %>
  <div class="bg-white border border-gray-100 rounded-xl overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-gray-500 text-left">
        <tr>
          <th class="px-4 py-3 font-semibold">Service</th>
          <th class="px-4 py-3 font-semibold">Category</th>
          <th class="px-4 py-3 font-semibold">Provider rate</th>
          <th class="px-4 py-3 font-semibold">Your rate</th>
          <th class="px-4 py-3 font-semibold">Min/Max</th>
          <th class="px-4 py-3 font-semibold">Status</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% services.forEach(function(s) { %>
          <tr>
            <td class="px-4 py-3 font-medium"><%= s.name %><% if (s.provider_service_id) { %><span class="block text-xs text-gray-400">provider id: <%= s.provider_service_id %></span><% } %></td>
            <td class="px-4 py-3 text-gray-500"><%= s.category_name || '—' %></td>
            <td class="px-4 py-3 text-gray-500"><%= s.provider_rate_per_1000 != null ? site.currency + s.provider_rate_per_1000.toFixed(2) : '—' %></td>
            <td class="px-4 py-3 font-semibold"><%= site.currency %><%= s.rate_per_1000.toFixed(2) %></td>
            <td class="px-4 py-3 text-gray-500"><%= s.min_quantity %> / <%= s.max_quantity %></td>
            <td class="px-4 py-3">
              <span class="px-2 py-0.5 rounded-full text-xs font-semibold <%= s.status === 'active' ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600' %>"><%= s.status %></span>
            </td>
            <td class="px-4 py-3 text-right">
              <a href="/admin/services/<%= s.id %>/edit" class="text-brand-700 font-semibold text-xs hover:underline">Edit</a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>

<%- include('../partials/admin_shell_close') %>
<%- include('../partials/footer') %>
