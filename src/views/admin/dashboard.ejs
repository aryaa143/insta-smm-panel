<%- include('../partials/head', { title }) %>
<%- include('../partials/nav') %>
<%- include('../partials/admin_shell_open', { active }) %>

  <h1 class="text-2xl font-extrabold mb-6">Admin dashboard</h1>

  <%- include('../partials/flash') %>

  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="bg-white border border-gray-100 rounded-xl p-5">
      <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Users</p>
      <p class="text-2xl font-extrabold"><%= stats.users %></p>
    </div>
    <div class="bg-white border border-gray-100 rounded-xl p-5">
      <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Revenue (non-refunded orders)</p>
      <p class="text-2xl font-extrabold"><%= site.currency %><%= stats.revenue.toFixed(2) %></p>
    </div>
    <div class="bg-white border border-gray-100 rounded-xl p-5">
      <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Pending fund requests</p>
      <p class="text-2xl font-extrabold"><%= stats.pendingFundRequests %></p>
      <a href="/admin/fund-requests" class="text-xs text-brand-700 font-semibold hover:underline">Review &rarr;</a>
    </div>
    <div class="bg-white border border-gray-100 rounded-xl p-5">
      <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Provider balance</p>
      <% if (providerBalance) { %>
        <p class="text-2xl font-extrabold"><%= providerBalance.currency || '' %> <%= providerBalance.balance %></p>
      <% } else if (providerError) { %>
        <p class="text-sm text-red-600"><%= providerError %></p>
      <% } else { %>
        <p class="text-sm text-gray-400">Not configured. <a href="/admin/settings" class="text-brand-700 underline">Set up</a></p>
      <% } %>
    </div>
  </div>

  <div class="bg-white border border-gray-100 rounded-xl p-6">
    <h2 class="font-bold mb-4">Orders by status</h2>
    <% if (stats.ordersByStatus.length === 0) { %>
      <p class="text-sm text-gray-500">No orders yet.</p>
    <% } else { %>
      <div class="flex flex-wrap gap-3">
        <% stats.ordersByStatus.forEach(function(s) { %>
          <div class="px-4 py-2 rounded-lg bg-gray-50 border border-gray-100 text-sm">
            <span class="font-semibold capitalize"><%= s.status %></span>: <%= s.n %>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <div class="grid sm:grid-cols-3 gap-4 mt-8">
    <a href="/admin/services" class="bg-white border border-gray-100 rounded-xl p-5 hover:border-brand-300">
      <p class="font-bold mb-1">Manage services</p>
      <p class="text-sm text-gray-500">Sync your provider's catalog and set your prices.</p>
    </a>
    <a href="/admin/orders" class="bg-white border border-gray-100 rounded-xl p-5 hover:border-brand-300">
      <p class="font-bold mb-1">Manage orders</p>
      <p class="text-sm text-gray-500">Review, sync and update order statuses.</p>
    </a>
    <a href="/admin/settings" class="bg-white border border-gray-100 rounded-xl p-5 hover:border-brand-300">
      <p class="font-bold mb-1">Settings</p>
      <p class="text-sm text-gray-500">Branding, currency and your provider API key.</p>
    </a>
  </div>

<%- include('../partials/admin_shell_close') %>
<%- include('../partials/footer') %>
