<%- include('../partials/head', { title }) %>
<%- include('../partials/nav') %>
<%- include('../partials/admin_shell_open', { active }) %>

  <h1 class="text-2xl font-extrabold mb-1">Orders</h1>
  <p class="text-gray-500 mb-4"><%= orders.length %> order(s)<%= status ? ` with status "${status}"` : '' %>.</p>

  <div class="flex flex-wrap gap-2 mb-4 text-xs">
    <% ['', 'pending', 'processing', 'in_progress', 'completed', 'partial', 'failed', 'canceled'].forEach(function(s) { %>
      <a href="/admin/orders<%= s ? '?status=' + s : '' %>"
         class="px-3 py-1.5 rounded-full border <%= status === s ? 'bg-gray-900 text-white border-gray-900' : 'border-gray-200 text-gray-600 hover:border-gray-400' %>">
        <%= s || 'all' %>
      </a>
    <% }); %>
  </div>

  <%- include('../partials/flash') %>

  <% if (orders.length === 0) { %>
    <div class="bg-white border border-dashed border-gray-200 rounded-xl p-8 text-center text-gray-500">No orders found.</div>
  <% } else { %>
  <div class="bg-white border border-gray-100 rounded-xl overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-gray-500 text-left">
        <tr>
          <th class="px-4 py-3 font-semibold">ID</th>
          <th class="px-4 py-3 font-semibold">User</th>
          <th class="px-4 py-3 font-semibold">Service</th>
          <th class="px-4 py-3 font-semibold">Qty</th>
          <th class="px-4 py-3 font-semibold">Charge</th>
          <th class="px-4 py-3 font-semibold">Status</th>
          <th class="px-4 py-3 font-semibold">Placed</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% orders.forEach(function(o) { %>
          <tr>
            <td class="px-4 py-3 text-gray-500">#<%= o.id %></td>
            <td class="px-4 py-3">
              <div class="font-medium"><%= o.user_name %></div>
              <div class="text-xs text-gray-400"><%= o.user_email %></div>
            </td>
            <td class="px-4 py-3"><%= o.service_name %></td>
            <td class="px-4 py-3"><%= o.quantity %></td>
            <td class="px-4 py-3"><%= site.currency %><%= o.charge.toFixed(2) %></td>
            <td class="px-4 py-3">
              <span class="px-2 py-0.5 rounded-full text-xs font-semibold
                <%= o.status === 'completed' ? 'bg-green-100 text-green-700' :
                    (o.status === 'failed' || o.status === 'canceled') ? 'bg-red-100 text-red-700' :
                    'bg-amber-100 text-amber-700' %>">
                <%= o.status %>
              </span>
            </td>
            <td class="px-4 py-3 text-gray-500 whitespace-nowrap"><%= o.created_at %></td>
            <td class="px-4 py-3">
              <div class="flex flex-col gap-2 min-w-[170px]">
                <% if (o.provider_order_id) { %>
                  <form action="/admin/orders/<%= o.id %>/sync" method="POST">
                    <button class="text-xs text-gray-500 hover:text-brand-700 font-semibold">Sync from provider</button>
                  </form>
                <% } %>
                <form action="/admin/orders/<%= o.id %>/set-status" method="POST" class="flex gap-1">
                  <select name="status" class="rounded border border-gray-300 px-1.5 py-1 text-xs">
                    <% ['pending','processing','in_progress','completed','partial','failed','canceled'].forEach(function(s) { %>
                      <option value="<%= s %>" <%= o.status === s ? 'selected' : '' %>><%= s %></option>
                    <% }); %>
                  </select>
                  <button class="px-2 py-1 rounded bg-gray-900 text-white text-xs font-semibold">Set</button>
                </form>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <p class="text-xs text-gray-400 mt-3">Setting an order to "failed" or "canceled" automatically refunds the customer's wallet (once).</p>
  <% } %>

<%- include('../partials/admin_shell_close') %>
<%- include('../partials/footer') %>
