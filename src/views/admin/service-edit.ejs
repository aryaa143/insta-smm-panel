<%- include('../partials/head', { title }) %>
<%- include('../partials/nav') %>
<%- include('../partials/admin_shell_open', { active }) %>

  <a href="/admin/services" class="text-sm text-gray-500 hover:text-gray-800">&larr; Back to services</a>
  <h1 class="text-2xl font-extrabold mt-2 mb-6">Edit service</h1>

  <form action="/admin/services/<%= service.id %>/update" method="POST" class="bg-white border border-gray-100 rounded-xl p-6 max-w-lg space-y-4">
    <div>
      <label class="block text-sm font-medium mb-1">Name</label>
      <input name="name" value="<%= service.name %>" required class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
    </div>
    <div>
      <label class="block text-sm font-medium mb-1">Description</label>
      <input name="description" value="<%= service.description || '' %>" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium mb-1">Your rate / 1000</label>
        <input name="rate_per_1000" type="number" step="0.01" min="0" value="<%= service.rate_per_1000 %>" required class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
        <% if (service.provider_rate_per_1000 != null) { %>
          <p class="text-xs text-gray-400 mt-1">Provider cost: <%= site.currency %><%= service.provider_rate_per_1000.toFixed(2) %></p>
        <% } %>
      </div>
      <div></div>
      <div>
        <label class="block text-sm font-medium mb-1">Min quantity</label>
        <input name="min_quantity" type="number" min="1" value="<%= service.min_quantity %>" required class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
      </div>
      <div>
        <label class="block text-sm font-medium mb-1">Max quantity</label>
        <input name="max_quantity" type="number" min="1" value="<%= service.max_quantity %>" required class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
      </div>
    </div>
    <div>
      <label class="block text-sm font-medium mb-1">Status</label>
      <select name="status" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
        <option value="active" <%= service.status === 'active' ? 'selected' : '' %>>Active (visible on storefront)</option>
        <option value="disabled" <%= service.status === 'disabled' ? 'selected' : '' %>>Disabled (hidden)</option>
      </select>
    </div>
    <button class="w-full py-2.5 rounded-lg brand-gradient text-white font-semibold hover:opacity-90">Save changes</button>
  </form>

<%- include('../partials/admin_shell_close') %>
<%- include('../partials/footer') %>
